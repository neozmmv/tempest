{
  "name": "backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "postgres": "^3.4.9"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "scripts": {
    "dev": "bun --watch --env-file=../.env ./src/main.ts",
    "db:generate": "bun --env-file=../.env drizzle-kit generate",
    "db:migrate": "bun --env-file=../.env drizzle-kit migrate",
    "db:push": "bun --env-file=../.env drizzle-kit push",
    "db:studio": "bun --env-file=../.env drizzle-kit studio"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@noble/curves": "^2.4.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "zod": "^4.6.5"
  }
}
